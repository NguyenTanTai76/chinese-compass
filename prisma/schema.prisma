generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  email     String   @unique
  name      String?
  avatarUrl String?  @map("avatar_url")
  xp        Int      @default(0)
  level     Int      @default(1)
  streak    Int      @default(0)
  lastActive DateTime? @map("last_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cardReviews    CardReview[]
  phraseReviews  PhraseReview[]
  studyLogs      StudyLog[]
}

model VocabWord {
  id          String   @id @default(cuid())
  hanzi       String   @unique
  pinyin      String
  meaningVi   String   @map("meaning_vi")
  hskLevel    Int      @map("hsk_level")
  audioUrl    String?  @map("audio_url")
  components  String[] @default([])
  createdAt   DateTime @default(now()) @map("created_at")

  cardReviews CardReview[]

  @@index([hskLevel])
}

model CardReview {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  vocabWordId   String   @map("vocab_word_id")
  easeFactor    Float    @default(2.5) @map("ease_factor")
  interval      Int      @default(0)
  repetitions   Int      @default(0)
  dueAt         DateTime @map("due_at")
  lastReviewed  DateTime @map("last_reviewed")
  createdAt     DateTime @default(now()) @map("created_at")

  user      Profile    @relation(fields: [userId], references: [userId], onDelete: Cascade)
  vocabWord VocabWord  @relation(fields: [vocabWordId], references: [id], onDelete: Cascade)

  @@unique([userId, vocabWordId])
  @@index([userId, dueAt])
}

model Phrase {
  id        String   @id @default(cuid())
  vietnamese String
  chinese   String   @unique
  pinyin    String
  category  String
  difficulty Int     @default(1)
  audioUrl  String?  @map("audio_url")
  createdAt DateTime @default(now()) @map("created_at")

  phraseReviews PhraseReview[]
}

model PhraseReview {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  phraseId  String   @map("phrase_id")
  correct   Boolean
  score     Float
  createdAt DateTime @default(now()) @map("created_at")

  user   Profile @relation(fields: [userId], references: [userId], onDelete: Cascade)
  phrase Phrase   @relation(fields: [phraseId], references: [id], onDelete: Cascade)

  @@unique([userId, phraseId])
  @@index([userId])
}

model StudyLog {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  type      String
  count     Int      @default(1)
  xpEarned  Int      @default(0) @map("xp_earned")
  date      DateTime @db.Date
  createdAt DateTime @default(now()) @map("created_at")

  user Profile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, date, type])
  @@index([userId, date])
}

model GrammarLesson {
  id          String   @id @default(cuid())
  title       String   @unique
  description String?
  level       Int
  content     String
  order       Int
  createdAt   DateTime @default(now()) @map("created_at")
}

model ReadingPassage {
  id          String   @id @default(cuid())
  title       String   @unique
  content     String
  level       Int
  wordCount   Int      @map("word_count")
  audioUrl    String?  @map("audio_url")
  createdAt   DateTime @default(now()) @map("created_at")
}

model ProgressEvent {
  id        String   @id
  userId    String   @map("user_id")
  sequence  BigInt   @map("sequence")
  event     Json     @map("event")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("ProgressEvent")
  @@index([userId, sequence])
}

model StudyPlan {
  userId    String   @map("user_id")
  weekStart DateTime @db.Date @map("week_start")
  plan      Json     @map("plan")
  revision  String?

  @@id([userId, weekStart])
  @@map("StudyPlan")
}