"use client";

import { useCallback, useEffect, useMemo, useState } from "react";
import { Check, RotateCcw, Volume2, X, RefreshCw, Cloud } from "lucide-react";

import { Button } from "@/components/ui/button";
import { VOCAB, type VocabEntry } from "@/lib/content/vocab";
import { addXp } from "@/lib/progress";
import { speakChinese, stopSpeaking } from "@/lib/speech";
import { cn } from "@/lib/utils";
import { toast } from "sonner";

type SM2State = {
  easeFactor: number;
  interval: number;
  repetitions: number;
  dueAt: string;
  lastReviewed?: string;
};

const SM2_KEY = "cc_sm2_v1";
const SYNC_KEY = "cc_sm2_synced_v1";
const initialSM2: SM2State = {
  easeFactor: 2.5,
  interval: 0,
  repetitions: 0,
  dueAt: new Date().toISOString(),
};

const QUALITY = { again: 0, hard: 3, good: 4, easy: 5 } as const;

function calcSM2(state: SM2State, quality: number): SM2State {
  let { easeFactor, interval, repetitions } = state;
  if (quality >= 3) {
    if (repetitions === 0) interval = 1;
    else if (repetitions === 1) interval = 6;
    else interval = Math.round(interval * easeFactor);
    repetitions += 1;
  } else {
    repetitions = 0;
    interval = 1;
  }
  easeFactor = Math.max(
    1.3,
    easeFactor + (0.1 - (5 - quality) * (0.08 + (5 - quality) * 0.02)),
  );
  const dueAt = new Date();
  dueAt.setDate(dueAt.getDate() + interval);
  return { easeFactor, interval, repetitions, dueAt: dueAt.toISOString(), lastReviewed: new Date().toISOString() };
}

function loadSM2(): Record<string, SM2State> {
  if (typeof window === "undefined") return {};
  try {
    return JSON.parse(window.localStorage.getItem(SM2_KEY) ?? "{}");
  } catch {
    return {};
  }
}

function persistSM2(states: Record<string, SM2State>) {
  if (typeof window === "undefined") return;
  window.localStorage.setItem(SM2_KEY, JSON.stringify(states));
}

function getLastSync(): number {
  if (typeof window === "undefined") return 0;
  try {
    return parseInt(window.localStorage.getItem(SYNC_KEY) ?? "0", 10);
  } catch {
    return 0;
  }
}

function setLastSync(timestamp: number) {
  if (typeof window === "undefined") return;
  window.localStorage.setItem(SYNC_KEY, timestamp.toString());
}

async function fetchServerReviews(): Promise<Record<string, SM2State>> {
  try {
    const res = await fetch("/api/vocab/reviews", { credentials: "include" });
    if (!res.ok) return {};
    const data = await res.json();
    const reviews = data.reviews ?? [];
    const map: Record<string, SM2State> = {};
    for (const r of reviews) {
      map[r.hanzi] = {
        easeFactor: r.easeFactor,
        interval: r.interval,
        repetitions: r.repetitions,
        dueAt: r.dueAt,
        lastReviewed: r.lastReviewed,
      };
    }
    return map;
  } catch {
    return {};
  }
}

async function pushReviewsToServer(states: Record<string, SM2State>): Promise<number> {
  try {
    const reviews = Object.entries(states).map(([hanzi, state]) => ({
      hanzi,
      easeFactor: state.easeFactor,
      interval: state.interval,
      repetitions: state.repetitions,
      dueAt: state.dueAt,
      lastReviewed: state.lastReviewed ?? new Date().toISOString(),
    }));
    const res = await fetch("/api/vocab/reviews/sync", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      credentials: "include",
      body: JSON.stringify({ reviews }),
    });
    if (!res.ok) return 0;
    const data = await res.json();
    return data.synced ?? 0;
  } catch {
    return 0;
  }
}

export default function VocabPage() {
  const [level, setLevel] = useState<"all" | 1 | 2>("all");
  const [index, setIndex] = useState(0);
  const [showAnswer, setShowAnswer] = useState(false);
  const [showPinyinSetting, setShowPinyinSetting] = useState(true);
  const [states, setStates] = useState<Record<string, SM2State>>({});
  const [session, setSession] = useState({ graded: 0, again: 0 });
  const [syncing, setSyncing] = useState(false);
  const [lastSync, setLastSyncState] = useState<number>(0);
  const [userLoaded, setUserLoaded] = useState(false);

  useEffect(() => {
    const local = loadSM2();
    setStates(local);
    setLastSyncState(getLastSync());

    const checkAuth = async () => {
      try {
        const res = await fetch("/api/auth/user", { credentials: "include" });
        if (res.ok) {
          const serverReviews = await fetchServerReviews();
          if (Object.keys(serverReviews).length > 0) {
            const merged = { ...serverReviews };
            for (const [hanzi, localState] of Object.entries(local)) {
              const serverState = merged[hanzi];
              if (!serverState || (localState.lastReviewed && new Date(localState.lastReviewed) > new Date(serverState.lastReviewed || 0))) {
                merged[hanzi] = localState;
              }
            }
            setStates(merged);
            persistSM2(merged);
          }
        }
      } catch {
        // Ignore auth errors
      } finally {
        setUserLoaded(true);
      }
    };

    checkAuth();
  }, []);

  const pool = useMemo(() => {
    const words = level === "all" ? VOCAB : VOCAB.filter((word) => word.hskLevel === level);
    return [...words].sort((a, b) => a.hanzi.localeCompare(b.hanzi));
  }, [level]);

  useEffect(() => {
    setIndex(0);
    setShowAnswer(false);
  }, [level]);

  const current: VocabEntry | undefined = pool[index % Math.max(1, pool.length)];
  const state = current ? states[current.hanzi] ?? initialSM2 : initialSM2;

  const dueCount = useMemo(
    () =>
      pool.filter((word) => {
        const item = states[word.hanzi];
        return item && new Date(item.dueAt) <= new Date();
      }).length,
    [pool, states],
  );

  const learnedCount = useMemo(
    () => pool.filter((word) => states[word.hanzi]?.repetitions).length,
    [pool, states],
  );

  const grade = useCallback(
    (quality: number, tone: "again" | "hard" | "good" | "easy") => {
      if (!current) return;
      const next = calcSM2(state, quality);
      const nextStates = { ...states, [current.hanzi]: next };
      setStates(nextStates);
      persistSM2(nextStates);
      setShowAnswer(false);
      setIndex((prev) => (prev + 1) % pool.length);
      setSession((prev) => ({
        graded: prev.graded + 1,
        again: prev.again + (tone === "again" ? 1 : 0),
      }));
      addXp(tone === "again" ? 1 : 2);
    },
    [current, pool.length, state, states],
  );

  const handleSync = useCallback(async () => {
    if (syncing) return;
    setSyncing(true);
    try {
      const synced = await pushReviewsToServer(states);
      if (synced > 0) {
        const now = Date.now();
        setLastSync(now);
        setLastSyncState(now);
        toast.success(`Đã đồng bộ ${synced} thẻ ôn tập`);
      } else {
        toast.info("Không có dữ liệu mới để đồng bộ");
      }
    } catch {
      toast.error("Đồng bộ thất bại. Thử lại sau.");
    } finally {
      setSyncing(false);
    }
  }, [syncing, states]);

  useEffect(() => {
    return () => stopSpeaking();
  }, []);

  if (!current) {
    return <p className="py-10 text-center text-muted-foreground">Chưa có từ vựng.</p>;
  }

  const progressPct = pool.length > 0 ? ((index % pool.length) / pool.length) * 100 : 0;

  return (
    <div className="mx-auto max-w-2xl space-y-5">
      <header className="flex flex-wrap items-end justify-between gap-3">
        <div>
          <h1 className="text-2xl font-bold text-primary">Flashcard từ vựng</h1>
          <p className="text-sm text-muted-foreground">
            Lặp lại ngắt quãng SM-2. Chọn mức độ nhớ để hệ thống hẹn ngày ôn.
          </p>
        </div>
        <div className="flex items-center gap-1 text-xs">
          {(["all", 1, 2] as const).map((item) => (
            <button
              key={item}
              type="button"
              onClick={() => setLevel(item)}
              className={cn(
                "rounded-full border px-3 py-1",
                level === item
                  ? "border-primary bg-primary text-white"
                  : "border-border bg-card text-muted-foreground hover:border-primary/40",
              )}
            >
              {item === "all" ? "Tất cả" : `HSK ${item}`}
            </button>
          ))}
        </div>
      </header>

      <div className="flex flex-wrap items-center gap-2 text-xs">
        <span className="rounded-full bg-primary/10 px-2.5 py-1 text-primary">
          Bộ thẻ: {pool.length}
        </span>
        <span className="rounded-full border border-border bg-card px-2.5 py-1 text-muted-foreground">
          Đã học: {learnedCount}
        </span>
        <span className="rounded-full border border-border bg-card px-2.5 py-1 text-muted-foreground">
          Đến hạn: {dueCount}
        </span>
        <span className="rounded-full border border-border bg-card px-2.5 py-1 text-muted-foreground">
          Phiên này: {session.graded} thẻ
        </span>
        {userLoaded && (
          <Button
            variant="outline"
            size="sm"
            onClick={handleSync}
            disabled={syncing}
            className="gap-1"
          >
            <Cloud className="h-3 w-3" />
            {syncing ? (
              <>
                <RefreshCw className="h-3 w-3 animate-spin" />
                Đang đồng bộ...
              </>
            ) : lastSync > 0 ? (
              `Đã sync ${new Date(lastSync).toLocaleTimeString()}`
            ) : (
              "Đồng bộ lên đám mây"
            )}
          </Button>
        )}
      </div>

      <div className="h-1.5 overflow-hidden rounded-full bg-muted">
        <div className="h-full bg-primary transition-all" style={{ width: `${progressPct}%` }} />
      </div>

      <section className="rounded-2xl border border-border bg-card p-7 text-center shadow-sm">
        <div className="hanzi select-none text-6xl font-bold leading-tight text-foreground">
          {current.hanzi}
        </div>

        {showPinyinSetting && (
          <p className="mt-2 text-lg text-primary">{current.pinyin}</p>
        ))

        {!showAnswer ? (
          <div className="mt-7 space-y-4">
            <Button size="lg" onClick={() => setShowAnswer(true)}>
              Lật thẻ
            </Button>
            <div className="flex justify-center gap-2">
              <Button
                variant="outline"
                size="sm"
                onClick={() => speakChinese(current.hanzi, 0.85)}
              >
                <Volume2 className="h-4 w-4" /> Nghe
              </Button>
              <Button
                variant="ghost"
                size="sm"
                onClick={() => setShowPinyinSetting((prev) => !prev)}
              >
                {showPinyinSetting ? "Ẩn" : "Hiện"} pinyin
              </Button>
            </div>
          </div>
        ) : (
          <div className="mt-5 space-y-4">
            <p className="text-xl font-medium text-primary">{current.meaningVi}</p>
            <p className="text-xs text-muted-foreground">
              HSK {current.hskLevel} · Lần ôn {state.repetitions} · Giãn cách{" "}
              {state.interval} ngày
            </p>

            <Button
              variant="outline"
              size="sm"
              onClick={() => speakChinese(current.hanzi, 0.85)}
            >
              <Volume2 className="h-4 w-4" /> Phát âm
            </Button>

            <div className="grid grid-cols-2 gap-2 pt-2 sm:grid-cols-4">
              <Button
                variant="danger"
                onClick={() => grade(QUALITY.again, "again")}
              >
                <X className="h-4 w-4" /> Lại
              </Button>
              <Button
                variant="secondary"
                onClick={() => grade(QUALITY.hard, "hard")}
              >
                <RotateCcw className="h-4 w-4" /> Khó
              </Button>
              <Button onClick={() => grade(QUALITY.good, "good")}>
                <Check className="h-4 w-4" /> Tốt
              </Button>
              <Button
                variant="success"
                onClick={() => grade(QUALITY.easy, "easy")}
              >
                Dễ
              </Button>
            </div>
          </div>
        )}
      </section>

      <div className="flex justify-between text-xs text-muted-foreground">
        <button
          type="button"
          className="hover:text-primary"
          onClick={() => {
            setIndex((prev) => (prev - 1 + pool.length) % pool.length);
            setShowAnswer(false);
          }}
        >
          ← Thẻ trước
        </button>
        <span>
          Thẻ {(index % pool.length) + 1}/{pool.length}
        </span>
        <button
          type="button"
          className="hover:text-primary"
          onClick={() => {
            setIndex((prev) => (prev + 1) % pool.length);
            setShowAnswer(false);
          }}
        >
          Bỏ qua →
        </button>
      </div>

      <p className="text-center text-xs text-muted-foreground">
        {userLoaded
          ? "Đã kết nối tài khoản. Tiến độ SM-2 đồng bộ nhiều thiết bị."
          : "Tiến độ SM-2 được lưu trên thiết bị này. Đăng nhập để đồng bộ nhiều thiết bị."}
      </p>
    </div>
  );
}